<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the framework the game host runs on (Vintagestory.runtimeconfig.json says
         net10.0). A startup hook is loaded by the same runtime as the app, before Main. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BetterModsHook</AssemblyName>
    <RootNamespace>BetterMods.Hook</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Deliberately NOT under bin\$(Configuration)\Mods: a loose .dll inside a mod search path is
         collected as EnumModSourceType.DLL and errors out as a code mod with no ModSystem. -->
    <OutputPath>..\bin\$(Configuration)\Hook</OutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- This assembly is loaded before the game's AssemblyResolver exists, so it must be loadable
         standalone. It therefore references NOTHING but the framework - no VintagestoryAPI, no
         VintagestoryLib, no 0Harmony. Everything it touches of those is pure reflection.
         Do not add a <Reference> or <PackageReference> here. -->
  </PropertyGroup>

  <!-- Release builds map the project folder to /_/ so shipped binaries carry no local paths. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
